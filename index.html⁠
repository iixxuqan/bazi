    function shareURL() {
      const name = encodeURIComponent(document.getElementById('userName').value);
      const birthDate = document.getElementById('birthDate').value;
      const birthTime = document.getElementById('birthTime').value;
      const mbti = document.getElementById('mbtiSelect').value;
      const hd = document.getElementById('hdTypeSelect').value;

      const shareLink = `${window.location.origin}${window.location.pathname}?name=${name}&birthDate=${birthDate}&birthTime=${birthTime}&mbti=${mbti}&hd=${hd}`;

      navigator.clipboard.writeText(shareLink).then(() => {
        alert('專屬報告網址已複製到剪貼簿！您可以發送給好友或分享到社群。');
      }).catch(() => {
        alert('複製失敗，請直接複製瀏覽器上方網址：\n' + shareLink);
      });
    }
